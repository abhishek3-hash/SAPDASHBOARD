@app.post("/dumps", response_model=List[DumpResponse])
def run_dynamic_dumps_sync(payload: SAPConnectionPayload, date: Optional[str] = None, current_user: dict = Depends(get_current_user)):
    if not date:
        date = datetime.now().strftime("%Y%m%d")
    config = {k: str(v).strip() for k, v in payload.model_dump().items()}
    try:
        with Connection(**config) as conn:
            fields = [{"FIELDNAME": "DATUM"}, {"FIELDNAME": "UZEIT"}, {"FIELDNAME": "UNAME"}, {"FIELDNAME": "SEQNO"}, {"FIELDNAME": "AHOST"}, {"FIELDNAME": "MODNO"}]
            result = conn.call("RFC_READ_TABLE", QUERY_TABLE="SNAP", DELIMITER="|", FIELDS=fields, OPTIONS=[{"TEXT": f"DATUM = '{date}'"}], ROWCOUNT=10)
            dumps = []
            for row in result.get("DATA", []):
                values = row["WA"].split("|")
                raw_dump = dict(zip([f["FIELDNAME"] for f in fields], [v.strip() for v in values]))
                dumps.append({"datum": raw_dump.get("DATUM", ""), "uzeit": raw_dump.get("UZEIT", ""), "uname": raw_dump.get("UNAME", ""), "seqno": raw_dump.get("SEQNO", ""), "ahost": raw_dump.get("AHOST", ""), "modno": raw_dump.get("MODNO", "")})
            return safe_decode(dumps)
    except Exception:
        return []

